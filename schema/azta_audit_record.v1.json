{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azta.spec/schema/azta_audit_record.v1.json",
  "title": "AZTA Runtime Audit Event",
  "description": "Canonical schema for deterministic, immutable audit traces generated by Agentic Zero Trust Architecture gateways.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "trace_id",
    "agent_id",
    "initiating_user",
    "system_prompt",
    "llm_transaction",
    "policy_evaluation",
    "tool_execution",
    "integrity_signature"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUIDv4 identifying this specific execution event."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp recording transaction completion."
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "W3C TraceContext Trace ID (32 hex characters) linking all sub-spans across microservices."
    },
    "agent_id": {
      "type": "string",
      "pattern": "^AGT-[A-Z0-9_-]+$",
      "description": "Unique organizational identifier for the autonomous agent actor.",
      "examples": ["AGT-001-SUPPORT", "AGT-002-PR-REVIEWER"]
    },
    "initiating_user": {
      "type": "object",
      "required": ["user_id", "auth_context_type", "delegated_scopes"],
      "properties": {
        "user_id": {
          "type": "string",
          "description": "Authenticated identifier of the human operator or upstream service triggering the agent."
        },
        "auth_context_type": {
          "type": "string",
          "enum": ["RFC8693_TOKEN_EXCHANGE", "DIRECT_OAUTH", "SERVICE_ACCOUNT", "ANONYMOUS_UNTRUSTED"]
        },
        "delegated_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of explicit OAuth/RBAC scopes granted during token exchange."
        }
      },
      "additionalProperties": false
    },
    "system_prompt": {
      "type": "object",
      "required": ["version", "sha256"],
      "properties": {
        "version": {
          "type": "string",
          "description": "SemVer or git commit hash of the active system prompt template.",
          "examples": ["v3.1.2", "git-e8a31c"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of the exact system prompt instruction set active at execution time."
        }
      },
      "additionalProperties": false
    },
    "llm_transaction": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "prompt_tokens",
        "completion_tokens",
        "context_window_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["Anthropic", "OpenAI", "AzureOpenAI", "AWSBedrock", "SelfHosted"]
        },
        "model": {
          "type": "string",
          "description": "Exact base model string returned by provider API."
        },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "context_window_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of the complete prompt context window including system instructions and RAG chunks."
        }
      },
      "additionalProperties": false
    },
    "policy_evaluation": {
      "type": "object",
      "required": ["opa_decision", "rule_evaluated", "hitl_required"],
      "properties": {
        "opa_decision": {
          "type": "string",
          "enum": ["ALLOW", "DENY", "HITL_PENDING"]
        },
        "rule_evaluated": {
          "type": "string",
          "description": "Fully qualified Rego policy path evaluated by OPA.",
          "examples": ["azta.policy.mcp.zendesk.allow"]
        },
        "hitl_required": { "type": "boolean" },
        "denial_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tool_execution": {
      "type": "object",
      "required": [
        "mcp_server_id",
        "function_name",
        "sanitized_parameters",
        "http_status_code",
        "execution_duration_ms"
      ],
      "properties": {
        "mcp_server_id": { "type": "string" },
        "function_name": { "type": "string" },
        "sanitized_parameters": {
          "type": "object",
          "description": "Redacted JSON object containing parameters passed to the tool endpoint."
        },
        "http_status_code": { "type": "integer" },
        "execution_duration_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "integrity_signature": {
      "type": "string",
      "description": "HMAC-SHA256 signature generated at gateway using KMS key to verify event immutability.",
      "examples": ["hmac-sha256:7f81b2c4e..."]
    }
  },
  "additionalProperties": false
}
